st/shell.d/keybindings-menu-test.sh","kind":"file","line":192},{"id":"SW-REQ-260922-9DMS","kind":"requirement"},{"id":"SW-REQ-260922-0W96","kind":"requirement"},{"id":"proof/known-issues/KI-MENU-KEYBINDINGS-NO-TIMEOUT.yaml","kind":"file","line":1},{"id":"test/shell.d/keybindings-menu-test.sh","kind":"test"},{"id":"test/shell.d/menu-keybindings-lua-scan-test.sh","kind":"test"}],"severity":"info","title":"The observed obligation cell rests on keycode tests that this PR does not change","verification":{"evidence":[],"method":"untyped finding","note":"No typed claim: this finding is the author's judgement and is not checked against the package.","status":"unverifiable"}},{"detail":"Commit 24f959e5 re-reviews the implemented_by traces of 0W96 and 9DMS that the diff made suspect, citing the diff. Commit 0375251e adds `# Verifies: SW-REQ-260922-0W96` to the PR's new test. That line is ours: the upstream test file has no proof annotation. Commit 258ca2da adds the two 9DMS tags. It also moves REVIEW-75's citation from keybindings-menu-test.sh:223 to :225, the same assertion after the two inserted lines.","refs":[{"id":"test/shell.d/menu-keybindings-lua-scan-test.sh","kind":"file","line":2},{"id":"proof/reviews/REVIEW-75.yaml","kind":"file","line":11},{"id":"SW-REQ-260922-0W96","kind":"requirement"},{"id":"SW-REQ-260922-9DMS","kind":"requirement"}],"severity":"info","title":"Our proof work re-reviewed the traces, linked the PR's test, and moved one review citation","verification":{"evidence":[],"method":"untyped finding","note":"No typed claim: this finding is the author's judgement and is not checked against the package.","status":"unverifiable"}},{"detail":"review.effects is absent for this bash/Lua change, so no new call paths, gained effects or callers were computed. The empty spec-gap list proves nothing about uncodified connections (review.scope approximations). From reading: build_lua_bind_cache is called only from output_binding_records_uncached (line 578), on a cache