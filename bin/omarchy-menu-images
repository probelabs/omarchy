#!/bin/bash

# omarchy:summary=Open a generic image selector menu
# omarchy:args=[--selected <image>] [--print-name] [--show-labels] [--filterable] [--lazy-thumbnails] [--preload] [--cache-only] [--print-rows] <image-dir>...

# Implements: SW-REQ-260922-43HQ, SW-REQ-260922-MH9B, SW-REQ-260929-THMB, SW-REQ-260929-REJT

selected_image=""
print_name=false
show_labels=false
filterable=false
lazy_thumbnails=false
prepare_only=false
preload=false
cache_only=false
print_rows=false
image_dirs=()

usage() {
  echo "Usage: omarchy-menu-images [--selected <image>] [--print-name] [--show-labels] [--filterable] [--lazy-thumbnails] [--preload] [--cache-only] [--print-rows] <image-dir>..."
}

while (( $# > 0 )); do
  case "$1" in
    --selected)
      if (( $# < 2 )); then
        usage >&2
        exit 1
      fi

      selected_image="$2"
      shift 2
      ;;
    --print-name)
      print_name=true
      shift
      ;;
    --show-labels)
      show_labels=true
      shift
      ;;
    --filterable)
      filterable=true
      shift
      ;;
    --lazy-thumbnails)
      lazy_thumbnails=true
      shift
      ;;
    --prepare-only)
      prepare_only=true
      shift
      ;;
    --preload)
      preload=true
      shift
      ;;
    --cache-only)
      cache_only=true
      shift
      ;;
    --print-rows)
      print_rows=true
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      image_dirs+=("$1")
      shift
      ;;
  esac
done

if (( ${#image_dirs[@]} == 0 )); then
  usage >&2
  exit 1
fi

selection_file=$(mktemp)
done_file=$(mktemp)
pending_file=$(mktemp)
pending_video_file=$(mktemp)
rm -f "$done_file"
trap 'rm -f "$selection_file" "$done_file" "$pending_file" "$pending_video_file"' EXIT

image_dirs_env=""
for dir in "${image_dirs[@]}"; do
  if [[ -z $image_dirs_env ]]; then
    image_dirs_env="$dir"
  else
    image_dirs_env+=$'\n'"$dir"
  fi
done

current_image=$(readlink -f "$selected_image" 2>/dev/null)
selected_list_image=""

if [[ -n $current_image ]]; then
  for dir in "${image_dirs[@]}"; do
    if [[ -d $dir && -f $selected_image && ${selected_image%/*} == "$dir" ]]; then
      selected_list_image="$selected_image"
      break
    elif [[ -d $dir ]]; then
      selected_list_image=$(find -L "$dir" -maxdepth 1 -type f -samefile "$current_image" -print -quit 2>/dev/null)
      # mcdc:ignore:tooling-limit the found arm ends in a bare break, which the engine records as a second condition that is always true, so that condition never has an independence pair; both arms are behaviorally exercised by the resolve-by-content scenario, where the samefile search answers with the row to lead with
      [[ -n $selected_list_image ]] && break
    fi
  done
fi

cache_dir=${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/image-selector
index_file="$cache_dir/index.tsv"
rows=""
mkdir -p "$cache_dir"

cache_key=$(printf '%s' "$image_dirs_env" | md5sum | cut -d ' ' -f 1)
rows_cache_file="$cache_dir/$cache_key.rows"
rows_signature_file="$cache_dir/$cache_key.signature"
rows_fast_signature_file="$cache_dir/$cache_key.fast-signature"
rows_signature="v4"$'\n'
rows_fast_signature="v3"$'\n'
rows_cacheable=true
rows_cache_hit=false
image_files=()

for dir in "${image_dirs[@]}"; do
  # mcdc:ignore:tooling-limit append-assignment idiom: the RHS assignment always succeeds, so the exit-status outcome is constant and no MC/DC independence pair exists (masking); both directory states are behaviorally tested by the multi-directory scenario
  [[ -d $dir ]] && rows_fast_signature+="$dir:$(stat -Lc '%Y' "$dir")"$'\n'
done

if [[ -f $rows_cache_file && -f $rows_fast_signature_file ]] && cmp -s "$rows_fast_signature_file" <(printf '%s' "$rows_fast_signature"); then
  rows=$(<"$rows_cache_file")
  rows_cache_hit=true
else
  for dir in "${image_dirs[@]}"; do
    if [[ -d $dir ]]; then
      rows_signature+="$dir:$(stat -Lc '%Y' "$dir")"$'\n'

      while IFS= read -r -d '' image; do
        image_files+=("$image")
        # mcdc:ignore:tooling-limit stat can only fail here if the file vanishes between the find above and this stat, a race the harness cannot stage deterministically, and the skip arm is a bare continue, which the engine records as a second condition that is always true, so the outcome is constant; missing signatures are behaviorally covered by every rebuild
        image_signature=$(stat -Lc '%s:%Y' "$image") || continue
        rows_signature+="$image:$image_signature"$'\n'
      done < <(find -L "$dir" -maxdepth 1 -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.bmp' -o -iname '*.webp' \
           -o -iname '*.mp4' -o -iname '*.m4v' -o -iname '*.mov' -o -iname '*.webm' -o -iname '*.mkv' -o -iname '*.avi' \) \
        -print0 2>/dev/null | sort -z)
    fi
  done
fi

# The extension decides the converter lane and whether a rejection may be
# recorded at all.
is_video_path() {
  [[ ${1,,} =~ \.(mp4|m4v|mov|webm|mkv|avi)$ ]]
}

# One generator per file: reap an aged legacy directory lock, serialize on a
# content-hash lock, dispatch to the format-appropriate converter, and record
# a rejection marker when a video is refused.
generate_thumbnail() {
  local image="$1"
  local thumbnail="$2"
  local lock="$thumbnail.lock"
  local lock_fd
  local tmp="$thumbnail.$$.jpg"
  local thumbnail_command

  # Older releases used directories as locks, which could survive a killed
  # generator and block this thumbnail forever. Only reap aged ones, so a
  # legacy generator still running through an upgrade keeps its lock.
  # mcdc:ignore:tooling-limit the stat fallback only fires if the lock vanishes between the -d check and this stat, a race the harness cannot stage deterministically, and the date RHS always succeeds so the outcome is constant (masking); both lock ages are behaviorally tested by the aged-lock and fresh-lock scenarios
  if [[ -d $lock ]] && (( $(date +%s) - $(stat -c '%Y' "$lock" 2>/dev/null || date +%s) > 120 )); then
    rmdir "$lock" 2>/dev/null
  fi

  # mcdc:ignore:tooling-limit the refused arm is a bare return, which the engine records as a second condition carrying the failed open's status, so that condition is always false and never has an independence pair; the arm is behaviorally exercised by the fresh-legacy-lock scenario, where the lock is still a directory
  exec {lock_fd}>"$lock" || return
  # mcdc:ignore:tooling-limit the timed-out arm needs a lock holder that outlasts the 30 second wait, which the harness cannot stage in a bounded run, and its bare return is recorded as a second condition that is always false, so it never has an independence pair; serialization under contention is behaviorally tested by the concurrent-runs scenario
  flock -w 30 "$lock_fd" || return

  # A generator killed mid-write leaves its partial $thumbnail.<pid>.jpg
  # behind. Only the lock holder writes these, so any found now are stale.
  rm -f "$thumbnail".*.jpg

  # mcdc:ignore:tooling-limit the already-generated arm is a bare return after a successful test, which the engine records as a second condition that is always true, so that condition never has an independence pair; the arm is behaviorally exercised by the concurrent-runs scenario, where the duplicate job finds the thumbnail the first generator moved into place
  [[ -f $thumbnail ]] && return

  # Callers fan out one generator per file, so keep each image conversion
  # single-threaded. ffmpegthumbnailer provides a still preview for videos.
  if is_video_path "$image"; then
    # Videos are generated before the picker opens, so one unreadable or
    # stalled file must not hold it shut. A failed run drops the row.
    thumbnail_command=(timeout -k 5 10 ffmpegthumbnailer -i "$image" -o "$tmp" -s 1536 -q 8)
  else
    thumbnail_command=(env VIPS_CONCURRENCY=1 vipsthumbnail "$image" --size 1536x864 --smartcrop=centre --path "$tmp[Q=82,strip]")
  fi

  # Close the lock fd for the converter: an orphaned or hung child must not
  # keep holding the lock after this shell is killed.
  if "${thumbnail_command[@]}" {lock_fd}>&-; then
    mv -f "$tmp" "$thumbnail"
  else
    status=$?
    rm -f "$tmp" "$thumbnail"
    # Remember a video the converter rejected, so it costs nothing on the next
    # open. The key covers size and mtime, so a repaired file starts clean. A
    # timeout is left to retry: the machine may only have been busy.
    if is_video_path "$image" && (( status != 124 && status != 137 )); then
      : >"$thumbnail.failed"
    fi
  fi
}

# Resolve one row: index the file by content hash, serve a cached thumbnail,
# hand back a recorded rejection, or route the file to the lazy or queued
# generation lane.
thumbnail_for() {
  local image="$1"
  local signature hash thumbnail

  # mcdc:ignore:tooling-limit stat can only fail here if the file vanishes between the directory scan and this stat, a race the harness cannot stage deterministically, and the failed arm's bare return is recorded as a second condition that is always false, so it never has an independence pair
  signature=$(stat -Lc '%s:%Y' "$image") || return
  hash=$(awk -F '\t' -v path="$image" -v sig="$signature" '$1 == path && $2 == sig { print $3; exit }' "$index_file" 2>/dev/null)

  if [[ -z $hash ]]; then
    hash=$(printf '%s\t%s' "$image" "$signature" | md5sum | cut -d ' ' -f 1)
    printf '%s\t%s\t%s\n' "$image" "$signature" "$hash" >>"$index_file"
  fi

  thumbnail="$cache_dir/$hash.jpg"

  if [[ ! -f $thumbnail ]]; then
    # A video that already failed to convert has no row to offer. Hand the
    # marker back so the caller can keep the rows uncached over its absence.
    if is_video_path "$image" && [[ -f $thumbnail.failed ]]; then
      printf '%s' "$thumbnail.failed"
      return
    fi

    # A lazy row stands in with the media file itself, which the picker draws
    # with an Image -- fine for a picture, blank for a video. Videos take the
    # queue instead, which also keeps them under its narrower fan out.
    if [[ $lazy_thumbnails == true && $cache_only != true ]] && ! is_video_path "$image"; then
      rows_cacheable=false

      if [[ $prepare_only != true ]]; then
        printf '%s\0%s\0' "$image" "$thumbnail" >>"$pending_file"
      fi

      printf '%s' "$image"
      return
    fi

    if is_video_path "$image"; then
      printf '%s\0%s\0' "$image" "$thumbnail" >>"$pending_video_file"
    else
      printf '%s\0%s\0' "$image" "$thumbnail" >>"$pending_file"
    fi
  fi

  printf '%s' "$thumbnail"
}

# Each vips run is single-threaded. Eager preparation can fill every core;
# lazy preparation leaves CPU and I/O capacity for the interactive shell.
# ffmpegthumbnailer leaves FFmpeg's automatic threading on, so a full-width fan
# out of those would put a codec thread pool on every core at once.
# Drain the queued files: still images fill every core, videos take one lane
# per four cores with a floor of one.
drain_pending_thumbnails() {
  local video_jobs image_jobs pending_fd queue_file queue_lock_fd worker_lock_fd

  export -f generate_thumbnail is_video_path

  if [[ -s $pending_file ]]; then
    if [[ $lazy_thumbnails == true && $cache_only != true ]]; then
      image_jobs=$(( $(nproc) / 2 ))
      # mcdc:ignore:tooling-limit default-assignment idiom: the RHS assignment always succeeds, so the exit-status outcome is constant and no MC/DC independence pair exists (masking); both pool sizes are behaviorally tested by the one-core and two-core pool scenarios
      (( image_jobs > 0 )) || image_jobs=1
      # mcdc:ignore:tooling-limit cap-assignment idiom: the RHS assignment always succeeds, so its condition is always true and has no independence pair (masking); both outcomes are observed, and the cap is behaviorally tested by the eight-core pool scenario
      (( image_jobs > 2 )) && image_jobs=2
      # Publish jobs before trying to own the pool. A contended refresh leaves
      # its jobs for the current owner instead of throwing its queue away.
      queue_file="$rows_cache_file.thumbnails.pending"
      # mcdc:ignore:tooling-limit the refused arm is a bare return, which the engine records as a second condition carrying the failed open's status, so that condition is always false and never has an independence pair; both arms are behaviorally tested, the refused one by the unopenable-queue-lock scenario
      exec {queue_lock_fd}>"$rows_cache_file.thumbnails.queue.lock" || return
      # mcdc:ignore:defensive a blocking flock on an open descriptor fails only when a signal interrupts it, which the harness cannot stage deterministically, and its bare return is recorded as a condition that is always false; publication under contention is behaviorally tested by the pool scenarios
      flock "$queue_lock_fd" || return
      cat "$pending_file" >>"$queue_file"
      exec {queue_lock_fd}>&-
      (
        exec {worker_lock_fd}>"$rows_cache_file.thumbnails.lock"
        # mcdc:ignore:tooling-limit both arms are observed, but the contended arm ends in exit 0, which the engine records as a true outcome, so the outcome is constant and no independence pair exists; the owner and the contended refresh are behaviorally tested by the pool scenarios
        flock -n "$worker_lock_fd" || exit 0
        # mcdc:ignore:defensive the producer opened this same lock file just before forking the pool, so this open fails only if the cache directory changes in between, a race the harness cannot stage, and its exit 1 tail is recorded as a condition that is always false
        exec {queue_lock_fd}>"$rows_cache_file.thumbnails.queue.lock" || exit 1
        # mcdc:ignore:tooling-limit the loop condition is the constant true, and the pool leaves the loop only through the break on an empty queue, so the condition has no false outcome; the drain-until-empty loop is behaviorally tested by the pool scenarios
        while true; do
          # mcdc:ignore:defensive a blocking flock on an open descriptor fails only when a signal interrupts it, which the harness cannot stage deterministically, and its exit 1 tail is recorded as a condition that is always false
          flock "$queue_lock_fd" || exit 1
          if [[ ! -s $queue_file ]]; then
            # Release ownership while publishing is still locked. A producer
            # arriving after the empty check can then start the next pool.
            exec {worker_lock_fd}>&-
            exec {queue_lock_fd}>&-
            break
          fi
          # Unlink the batch under the queue lock, then drain its open fd.
          # Producers can publish the next batch while conversions run.
          # mcdc:ignore:defensive only the pool owner removes the queue file, and it found the file non-empty under the queue lock it still holds, so this open fails only if another process deletes the file, which correct code never does; its exit 1 tail is recorded as a condition that is always false
          exec {pending_fd}<"$queue_file" || exit 1
          rm -f "$queue_file"
          flock -u "$queue_lock_fd"
          # Converters must not inherit the publication lock's descriptor.
          nice -n 10 ionice -c 3 xargs -0 -n 2 -P "$image_jobs" \
            bash -c 'generate_thumbnail "$1" "$2"' _ <&"$pending_fd" {queue_lock_fd}>&-
          exec {pending_fd}<&-
        done
      ) >/dev/null 2>&1 &
    else
      xargs -a "$pending_file" -0 -n 2 -P "$(nproc)" \
        bash -c 'generate_thumbnail "$1" "$2"' _ >/dev/null 2>&1 || true
    fi
  fi

  if [[ -s $pending_video_file ]]; then
    video_jobs=$(( $(nproc) / 4 ))
    # mcdc:ignore:tooling-limit default-assignment idiom: the RHS assignment always succeeds, so the exit-status outcome is constant and no MC/DC independence pair exists (masking); both lane counts are behaviorally tested by the default and single-lane video scenarios
    (( video_jobs > 0 )) || video_jobs=1
    xargs -a "$pending_video_file" -0 -n 2 -P "$video_jobs" \
      bash -c 'generate_thumbnail "$1" "$2"' _ >/dev/null 2>&1 || true
  fi
}

# Implements: SW-REQ-260922-43HQ, SW-REQ-260922-MH9B
if [[ $rows_cache_hit != true && -f $rows_cache_file && -f $rows_signature_file ]] && cmp -s "$rows_signature_file" <(printf '%s' "$rows_signature"); then
  rows=$(<"$rows_cache_file")
  printf '%s' "$rows_fast_signature" >"$rows_fast_signature_file"
elif [[ $rows_cache_hit != true ]]; then
  for image in "${image_files[@]}"; do
    thumbnail=$(thumbnail_for "$image")
    # mcdc:ignore:tooling-limit thumbnail_for only answers empty when its own stat guard bails, which is the vanishing-file race noted above and cannot be staged here, and the skip arm's bare continue is recorded as a second condition that is always true, so the outcome is constant
    [[ -n $thumbnail ]] || continue
    # Cached rows are trusted on the directory's mtime alone, which a file
    # repaired in place never changes. Leave them uncached instead.
    if [[ $thumbnail == *.failed ]]; then
      rows_cacheable=false
      continue
    fi
    if [[ $lazy_thumbnails == true && $cache_only != true && $thumbnail == $image ]]; then
      rows_cacheable=false
    fi

    if [[ -z $rows ]]; then
      rows="$image"$'\t'"$thumbnail"
    else
      rows+=$'\n'"$image"$'\t'"$thumbnail"
    fi
  done

  # Implements: SW-REQ-260922-MH9B, SW-REQ-260929-THMB
  drain_pending_thumbnails

  if [[ -s $pending_file || -s $pending_video_file ]]; then
    pruned=""
    while IFS=$'\t' read -r row_image row_thumbnail; do
      if [[ ! -e $row_thumbnail ]]; then
        rows_cacheable=false
        continue
      fi

      if [[ -z $pruned ]]; then
        pruned="$row_image"$'\t'"$row_thumbnail"
      else
        pruned+=$'\n'"$row_image"$'\t'"$row_thumbnail"
      fi
    done <<<"$rows"
    rows="$pruned"
  fi

  # Implements: SW-REQ-260922-MH9B
  # Publish the cache under a lock and via renames: a picker killed mid-write,
  # or two pickers interleaving, must never leave truncated or mismatched rows
  # behind signatures that still validate. Rows go first so a kill between
  # renames leaves signatures that are either older (a harmless miss) or
  # describe the same directory state.
  # mcdc:ignore:tooling-limit the open fails only if the cache directory vanishes mid-run and the flock only times out under a rows-lock holder that outlasts 30 seconds; neither can be staged deterministically, and publication under contention is behaviorally tested by the concurrent-runs scenario
  if exec {rows_lock_fd}>"$rows_cache_file.lock" && flock -w 30 "$rows_lock_fd"; then
    if [[ $rows_cacheable == true ]]; then
      rm -f "$cache_dir/$cache_key".*.tmp
      # mcdc:ignore:tooling-limit write-and-rename idiom: the printf and mv fail only on full-disk or foreign-directory conditions the harness cannot stage, so the exit-status outcome is constant whenever reached (masking); the publication itself is behaviorally tested by every caching scenario
      printf '%s' "$rows" >"$rows_cache_file.$$.tmp" && mv -f "$rows_cache_file.$$.tmp" "$rows_cache_file"
      # mcdc:ignore:tooling-limit write-and-rename idiom: the printf and mv fail only on full-disk or foreign-directory conditions the harness cannot stage, so the exit-status outcome is constant whenever reached (masking)
      printf '%s' "$rows_signature" >"$rows_signature_file.$$.tmp" && mv -f "$rows_signature_file.$$.tmp" "$rows_signature_file"
      # mcdc:ignore:tooling-limit write-and-rename idiom: the printf and mv fail only on full-disk or foreign-directory conditions the harness cannot stage, so the exit-status outcome is constant whenever reached (masking)
      printf '%s' "$rows_fast_signature" >"$rows_fast_signature_file.$$.tmp" && mv -f "$rows_fast_signature_file.$$.tmp" "$rows_fast_signature_file"
    else
      rm -f "$rows_cache_file" "$rows_signature_file" "$rows_fast_signature_file"
    fi
    exec {rows_lock_fd}>&-
  fi
fi

if [[ $cache_only == true || $prepare_only == true ]]; then
  exit 0
fi

# The shell keeps a copy of these rows so its picker can open without waiting
# on this script, and reads them back from stdout to refresh that copy.
if [[ $print_rows == true ]]; then
  printf '%s\n' "$rows"
  exit 0
fi

# Image rows can contain newlines and tabs, which don't survive positional
# shell IPC arguments. Base64-encode for transit; the ImagePicker plugin
# Qt.atob()s on the other side.
rows_b64=$(printf '%s' "$rows" | base64 -w 0)

if [[ $preload == true ]]; then
  # mcdc:ignore:tooling-limit "|| true" masking: the handoff outcome is discarded by design, so the exit-status outcome is constant and no MC/DC independence pair exists; the preload handoff is behaviorally tested by the preload scenario
  omarchy-shell image-selector preload "$rows_b64" "$selected_list_image" "$show_labels" "$filterable" >/dev/null || true
  exit 0
fi

if ! open_result=$(omarchy-shell image-selector open \
     "" \
     "$rows_b64" \
     "$selected_list_image" \
     "$selection_file" \
     "$done_file" \
     "$show_labels" \
     "$filterable"); then
  echo "Image selector failed to accept request" >&2
  exit 1
fi

if [[ $open_result != "ok" ]]; then
  echo "Image selector failed to accept request" >&2
  exit 1
fi

while [[ ! -e $done_file ]]; do
  sleep 0.01
done

if [[ -s $selection_file ]]; then
  if [[ $print_name == true ]]; then
    selection=$(<"$selection_file")
    selection=${selection##*/}
    printf '%s\n' "${selection%.*}"
  else
    cat "$selection_file"
  fi
fi
